{
  "name": "openclaw-lark-project",
  "version": "1.13.2",
  "description": "OpenClaw plugin for Lark Project workitem description updates",
  "type": "module",
  "license": "MIT",
  "files": [
    "skills",
    "src",
    "dist",
    "!src/**/*.test.ts",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xudongcc/openclaw-lark-project.git"
  },
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@isaacs/ttlcache": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "json-bigint": "^1.0.0",
    "lodash": "^4.17.23",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@types/json-bigint": "^1.0.4",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.3.5",
    "openclaw": "^2026.6.11",
    "semantic-release": "^25.0.3",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
